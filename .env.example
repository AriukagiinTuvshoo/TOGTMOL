# Optional. Empty values keep local-only mode fully usable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never put service_role keys, Google client secrets or AI keys in NEXT_PUBLIC_*.

# Optional online Bondook. All three are SERVER ONLY. Empty values keep local mode.
OPENAI_API_KEY=
# Use a Responses API model with structured outputs; image cards require vision input.
OPENAI_MODEL=
# Comma-separated Supabase user UUIDs permitted to use your paid AI provider.
BONDOOK_AI_ALLOWED_USER_IDS=
# Optional Mongolian voice input (server only).
CHIMEGE_API_TOKEN=
# Comma-separated allowlist; falls back to BONDOOK_AI_ALLOWED_USER_IDS when empty.
CHIMEGE_ALLOWED_USER_IDS=

# Production Supabase smoke test (dedicated test account only).
SUPABASE_PRODUCTION_URL=
SUPABASE_PRODUCTION_PUBLISHABLE_KEY=
SUPABASE_TEST_EMAIL=
SUPABASE_TEST_PASSWORD=
SUPABASE_EXPECTED_PROJECT_REF=
SUPABASE_REQUIRE_CONFIRMED_EMAIL=1
# Public contact shown on /privacy and /terms.
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
